{
  "name": "dmath-frontend",
  "version": "0.1.1",
  "private": true,
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "avoid",
    "endOfLine": "lf"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node scripts/start-standalone.js",
    "start:next": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@reduxjs/toolkit": "^2.9.0",
    "@sentry/nextjs": "^10.29.0",
    "d3-force": "^3.0.0",
    "dexie": "^3.2.7",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^24.2.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.544.0",
    "next-pwa": "^5.6.0",
    "react-i18next": "^15.1.2",
    "react-katex": "^3.0.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.13.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.27.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-plugin-boundaries": "^4.2.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "^15.2.11",
    "next": "^15.5.3",
    "postcss": "^8.4.47",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "whatwg-url": "^15.1.0",
    "workbox-build": "^7.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
